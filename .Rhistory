library(tidyverse)
library(dplyr)
library(stringr)
library(stringdist)
Candidates <- read.csv("School_Front (3-30).csv")
clean_text <- function(x) {
x %>%
str_to_lower() %>%
str_trim() %>%
str_replace_all("[[:punct:]]", "") %>%
str_squish()
}
state_lookup <- c(
"ny" = "New York",
"new york" = "New York",
"new york state" = "New York"
)
standardize_with_lookup <- function(x, lookup) {
cleaned <- clean_text(x)
recode(cleaned, !!!lookup, .default = cleaned)
}
fuzzy_match <- function(x, reference, max_dist = 2) {
sapply(x, function(val) {
distances <- stringdist(val, reference)
if (min(distances) <= max_dist) {
reference[which.min(distances)]
} else {
val
}
})
}
standardize_column <- function(x, reference_values) {
cleaned <- clean_text(x)
fuzzy_match(cleaned, reference_values)
}
Candidates$State_clean <- standardize_with_lookup(
Candidates$Permanent.State,
state_lookup
)
valid_states <- c("new york")
Candidates$State_clean <- fuzzy_match(
Candidates$State_clean,
valid_states
)
Candidates$Permanent.State
Candidates$State_clean
# Compare before vs after
head(data.frame(
original = Candidates$Permanent.State,
cleaned = Candidates$State_clean
))
# Compare before vs after
data.frame(
original = Candidates$Permanent.State,
cleaned = Candidates$State_clean
)
Candidates$Permanent.State
Candidates$Permanent.City
Candidates$Permanent.State
Candidates$State_clean <- fuzzy_match(
Candidates$State_clean,
valid_states
)
